# App
NEXT_PUBLIC_APP_URL=http://localhost:43123
PORT=43123

# Database (SQLite file path for local; use Postgres URL in production)
DATABASE_URL=file:./dev.db

# Session & signing (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-min-32-characters-long-secret
MEDIA_SIGNING_SECRET=change-me-another-32-char-secret
CSRF_SECRET=change-me-csrf-secret-32-chars

# Admin (bcrypt hash optional; plain password for dev only)
# Prefer bcrypt hash in production (generate: npx tsx -e "console.log(require('bcryptjs').hashSync('your-pass',12))")
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=dev-admin-change-me

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage: leave S3 vars empty to use local ./data/uploads
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads

# S3-compatible (Cloudflare R2, AWS S3, etc.)
# STORAGE_BACKEND=s3
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=

# Contact on landing page
NEXT_PUBLIC_WHATSAPP_NUMBER=995555123456
