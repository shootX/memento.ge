# App
NEXT_PUBLIC_APP_URL=http://localhost:43123
PORT=43123

# Database — PostgreSQL (production & recommended local via docker-compose)
DATABASE_URL=postgresql://memento:memento@localhost:5432/memento

# Session & signing (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-min-32-characters-long-secret
MEDIA_SIGNING_SECRET=change-me-another-32-char-secret
CSRF_SECRET=change-me-csrf-secret-32-chars

# Admin (bcrypt hash optional; plain password for dev only)
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=dev-admin-change-me

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# TBC Checkout — https://developers.tbcbank.ge/
TBC_ENV=sandbox
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
# TBC_PAYMENT_METHODS=5,6,7
# TBC_API_BASE_URL=https://api.tbcbank.ge
TBC_CALLBACK_URL=https://your-domain/api/webhooks/tbc
# Optional: Bearer or X-TBC-Webhook-Secret on callbacks; or TBC bank IPs; or HMAC:
# TBC_WEBHOOK_SECRET=
# TBC_WEBHOOK_HMAC_SECRET=

# Bank of Georgia — https://api.bog.ge/docs/
BOG_ENV=sandbox
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
BOG_CALLBACK_PUBLIC_KEY=
# BOG_PAYMENT_METHODS=card,google_pay,apple_pay
# BOG_TOKEN_URL=
# BOG_API_BASE_URL=https://api.bog.ge/payments/v1

# Local payment simulation (e2e / dev)
PAYMENT_MOCK=0
E2E_SECRET=local-e2e

# Apple Pay domain verification file contents or path
APPLE_PAY_DOMAIN_ASSOCIATION=
# APPLE_PAY_DOMAIN_ASSOCIATION_FILE=

# Flitt — https://docs.flitt.com/api/
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=
# FLITT_API_URL=https://pay.flitt.com/api/checkout/url

# Email — log | smtp | resend
EMAIL_PROVIDER=log
EMAIL_FROM=Memento <hello@memento.ge>
EMAIL_PROCESS_INLINE=1
# SMTP (MailHog/Mailcatcher: host 127.0.0.1 port 1025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Cron/worker — POST /api/cron/email with Authorization: Bearer <secret>
CRON_SECRET=change-me-cron-secret

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads
# STORAGE_BACKEND=s3
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

NEXT_PUBLIC_WHATSAPP_NUMBER=995555123456

# Google OAuth (login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@memento.ge

# PWA_DEV=1
# NEXT_PUBLIC_PWA_DEV=1
