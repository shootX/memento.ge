{
  "expo": {
    "name": "მემენტო",
    "slug": "memento-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "memento",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ge.memento.app",
      "associatedDomains": ["applinks:memento.ge", "applinks:www.memento.ge"]
    },
    "android": {
      "package": "ge.memento.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "memento.ge", "pathPrefix": "/e" },
            { "scheme": "memento", "host": "*", "pathPrefix": "/e" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "მემენტო იყენებს კამერას QR-ისა და ფოტოსთვის."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "მემენტო იყენებს გალერეას ფოტოს ასატვირთად."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "მემენტო ინახავს QR კოდს შენს ფოტოალბომში.",
          "savePhotosPermission": "მემენტო ინახავს QR კოდს შენს ფოტოალბომში.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0d0d0f"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "00000000-0000-4000-8000-000000000001"
      }
    },
    "owner": "shootx"
  }
}
