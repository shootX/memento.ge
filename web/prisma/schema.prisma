generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --- Auth & accounts ---

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // user | admin | partner
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  ownedEvents        Event[]          @relation("EventOwner")
  coHosts            EventCoHost[]
  partnerMemberships PartnerMember[]
  auditLogs          AuditLog[]
  payments           Payment[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OAuthAccount {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String

  @@unique([provider, providerUserId])
}

// --- Partners (B2B) ---

model PartnerOrg {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logoUrl          String?
  primaryColor     String   @default("#3d4f3f")
  secondaryColor   String   @default("#c4a574")
  commissionRate   Float    @default(0.15)
  creditsBalance   Int      @default(0)
  whiteLabel       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members      PartnerMember[]
  events       Event[]
  referrals    PartnerReferral[]
  subscription PartnerSubscription?
}

model PartnerMember {
  id        String     @id @default(cuid())
  partnerId String
  partner   PartnerOrg @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String     @default("owner") // owner | staff

  @@unique([partnerId, userId])
}

model PartnerReferral {
  id          String     @id @default(cuid())
  partnerId   String
  partner     PartnerOrg @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  eventId     String?    @unique
  event       Event?     @relation(fields: [eventId], references: [id])
  commissionGel Float    @default(0)
  status      String     @default("pending") // pending | paid
  createdAt   DateTime   @default(now())
}

model PartnerSubscription {
  id                 String     @id @default(cuid())
  partnerId          String     @unique
  partner            PartnerOrg @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  planId             String     @default("partner_starter")
  status             String     @default("active")
  externalProvider   String?
  externalSubscriptionId String?
  currentPeriodEnd   DateTime?
}

// --- Events & media ---

model Event {
  id              String    @id @default(cuid())
  guestSlug       String    @unique
  customSlug      String?   @unique
  hostToken       String    @unique
  slideshowToken  String    @unique
  coupleNames     String
  eventDate       DateTime
  coverPhotoKey   String?
  planTier        String    @default("starter")
  isPaid          Boolean   @default(false)
  paidAt          DateTime?
  expiresAt       DateTime?
  totalBytes      Int       @default(0)
  uploadCount     Int       @default(0)

  ownerUserId     String?
  owner           User?     @relation("EventOwner", fields: [ownerUserId], references: [id])
  partnerOrgId    String?
  partner         PartnerOrg? @relation(fields: [partnerOrgId], references: [id])

  disposableEnabled   Boolean   @default(false)
  shotsPerGuest       Int       @default(0)
  revealAt            DateTime?
  moderateUploads     Boolean   @default(false)
  publicGallery       Boolean   @default(false)
  galleryPasswordHash String?
  brandingPrimary     String?
  brandingLogoUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media         Media[]
  guestMessages GuestMessage[]
  coHosts       EventCoHost[]
  payments      Payment[]
  referral      PartnerReferral?
  guestQuotas   GuestShotQuota[]
}

model EventCoHost {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedAt DateTime @default(now())

  @@unique([eventId, userId])
}

model Media {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  storageKey  String   @unique
  thumbKey    String?
  mimeType    String
  size        Int
  guestName   String?
  guestKey    String?
  width       Int?
  height      Int?
  durationSec Float?
  status      String   @default("approved") // pending | approved | rejected
  highlight   Boolean  @default(false)
  createdAt   DateTime @default(now())

  reactions MediaReaction[]

  @@index([eventId, createdAt])
  @@index([eventId, status])
}

model GuestShotQuota {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestKey  String
  used      Int      @default(0)

  @@unique([eventId, guestKey])
}

model GuestMessage {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestName String?
  body      String?
  audioKey  String?
  type      String   @default("text") // text | audio
  status    String   @default("approved")
  createdAt DateTime @default(now())
}

model MediaReaction {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  guestKey  String
  type      String   @default("like")
  createdAt DateTime @default(now())

  @@unique([mediaId, guestKey])
}

// --- Billing ---

model Payment {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id])
  amountGel        Int
  currency         String   @default("GEL")
  provider         String   // stripe | bog | tbc | flitt | manual
  externalId       String?
  status           String   @default("pending")
  metadata         String?
  createdAt        DateTime @default(now())
}

// --- Ops ---

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model EmailOutbox {
  id        String    @id @default(cuid())
  toEmail   String
  template  String
  payload   String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model UsageSnapshot {
  id         String   @id @default(cuid())
  totalBytes BigInt   @default(0)
  eventCount Int      @default(0)
  capturedAt DateTime @default(now())
}
